        <mxCell id="BWJigJqh3MrbGP7vl0X3-188" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Restricciónes Butacas:&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Cliente:&lt;/span&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Solo puedo reservar las butacas disponibles.&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Cuando reservé una butaca que esta marque &quot;reservada&quot; en mi pantalla, pero marque ocupada para otros usuarios.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Solo puedo reservar tantas butacas como entradas halla comprado.&lt;/span&gt;&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="730" x="2400" y="630" as="geometry" />
        </mxCell>
        <mxCell id="BWJigJqh3MrbGP7vl0X3-146" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;Restricciónes funcion:&lt;/div&gt;&lt;ul&gt;&lt;li&gt;Solo existen funciones con dimension 2D o 3D.&lt;/li&gt;&lt;li&gt;No pueden haber dos funciones en la misma sala y en el mismo horario.&amp;nbsp;&lt;span style=&quot;text-align: center;&quot;&gt;UNIQUE(id_sala, id_horario)&lt;/span&gt;&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
